{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kurtvalcorza/language-model-pipeline/schemas/training-result.schema.json",
  "title": "result.json emitted by language-model-finetuner",
  "description": "Validated against documents produced by real training runs, success and failure alike. The success branch is the load-bearing part: it is what makes an artifact referenceable after the fact.",

  "allOf": [
    {"$ref": "result-common.schema.json#/$defs/resultBase"},
    {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "languageModelPipeline": {
              "type": "object",
              "properties": {
                "stage": {"const": "training"}
              },
              "required": ["stage"]
            }
          },
          "required": ["languageModelPipeline"]
        }
      }
    },
    {
      "description": "A successful run must describe what it produced and what it was produced from. Without both, the artifact cannot be traced back to a model, a revision, or a dataset.",
      "if": {
        "type": "object",
        "properties": {"successful": {"const": true}},
        "required": ["successful"]
      },
      "then": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "languageModelPipeline": {
                "type": "object",
                "properties": {
                  "code": {"const": "TRAINING_SUCCEEDED"},

                  "artifact": {
                    "type": "object",
                    "properties": {
                      "format": {"type": "string", "enum": ["peft_adapter"]},
                      "path": {"type": "string", "minLength": 1},
                      "fileCount": {"type": "integer", "minimum": 1},
                      "totalBytes": {"type": "integer", "minimum": 1},
                      "files": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "path": {"type": "string", "minLength": 1},
                            "bytes": {"type": "integer", "minimum": 0},
                            "sha256": {
                              "type": "string",
                              "description": "Every published file is hashed. A manifest entry without one cannot detect a truncated write.",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          },
                          "required": ["path", "bytes", "sha256"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["format", "path", "fileCount", "totalBytes", "files"]
                  },

                  "provenance": {
                    "type": "object",
                    "description": "What was actually loaded and run, not what was requested.",
                    "properties": {
                      "baseModel": {"type": "string", "minLength": 1},
                      "baseModelRevision": {
                        "type": "string",
                        "description": "The revision actually loaded. A branch name here would make the artifact unreproducible.",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      "baseModelLicense": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Upstream license identifier for the exact base model used by the run."
                      },
                      "licenseObligations": {
                        "type": "array",
                        "description": "Stable machine-readable downstream obligations derived from the reviewed base-model license. An empty list means the pipeline has no additional obligation recorded; it is not a legal conclusion about every possible use.",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "enum": [
                            "preserve_llama_attribution",
                            "include_applicable_license_notice"
                          ]
                        }
                      },
                      "modelKey": {"type": "string", "minLength": 1},
                      "quantized": {"type": "boolean"},
                      "datasetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "trustRemoteCode": {
                        "description": "Recorded so an artifact built with remote code execution enabled is identifiable after the fact.",
                        "const": false
                      },

                      "trainingControls": {
                        "type": "object",
                        "description": "What the training controls DID, as against what the job asked for -- the request is already legible in the embedded job document. Kept optional so pre-1.1 result fixtures remain schema-readable; the current finetuner emits this block on successful runs.",
                        "properties": {
                          "stoppingReason": {
                            "type": "string",
                            "description": "Why the run stopped. Two states only: it exhausted its epoch budget, or patience ran out. A failure does not reach this branch at all.",
                            "enum": ["epochs_completed", "early_stopping"]
                          },
                          "epochsCompleted": {
                            "type": "integer",
                            "description": "Epochs actually run. Without it `early_stopping` is an unfalsifiable claim -- there is no way to see that the run ended short of its budget.",
                            "minimum": 1
                          },
                          "bestEpoch": {
                            "type": "integer",
                            "description": "The epoch with the lowest validation loss, 1-based.",
                            "minimum": 1
                          },
                          "bestValidationLoss": {"type": "number", "minimum": 0},
                          "restoredBestAdapter": {
                            "type": "boolean",
                            "description": "Whether the published artifact is the best epoch's adapter or the last epoch's. The two are different artifacts and the file manifest cannot tell them apart, so the answer has to be stated here. `false` is the ordinary case and stays expressible."
                          },
                          "lrSchedulerType": {"type": "string", "enum": ["constant", "linear", "cosine"]},
                          "warmupSteps": {
                            "type": "integer",
                            "description": "The EFFECTIVE warmup in optimizer steps, already resolved from whichever spelling the job used. A ratio is not carried here: two readers dividing it by a step count they each derived is how the same run acquires two warmup lengths.",
                            "minimum": 0
                          },
                          "weightDecay": {"type": "number", "minimum": 0, "maximum": 1}
                        },
                        "required": [
                          "stoppingReason",
                          "epochsCompleted",
                          "bestEpoch",
                          "bestValidationLoss",
                          "restoredBestAdapter",
                          "lrSchedulerType",
                          "warmupSteps",
                          "weightDecay"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "baseModel",
                      "baseModelRevision",
                      "modelKey",
                      "quantized",
                      "datasetDigest",
                      "trustRemoteCode"
                    ]
                  }
                },
                "required": ["code", "artifact", "provenance"]
              }
            }
          }
        }
      }
    },
    {
      "description": "A failed run must not claim the success code, and must not advertise an artifact it did not publish.",
      "if": {
        "type": "object",
        "properties": {"successful": {"const": false}},
        "required": ["successful"]
      },
      "then": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "languageModelPipeline": {
                "type": "object",
                "properties": {
                  "code": {"not": {"const": "TRAINING_SUCCEEDED"}},
                  "artifact": {
                    "type": "object",
                    "not": {"required": ["path"]}
                  }
                },
                "required": ["code"]
              }
            }
          }
        }
      }
    }
  ]
}
