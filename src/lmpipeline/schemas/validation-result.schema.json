{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kurtvalcorza/language-model-pipeline/schemas/validation-result.schema.json",
  "title": "result.json emitted by language-model-dataset-validator",
  "description": "Validated against documents produced by real validate() runs, success and failure alike — not against hand-authored examples. A schema checked only against samples written to satisfy it proves nothing about what the container emits.",

  "allOf": [
    {"$ref": "result-common.schema.json#/$defs/resultBase"},
    {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "languageModelPipeline": {
              "type": "object",
              "properties": {
                "stage": {"const": "validation"}
              },
              "required": ["stage"]
            }
          },
          "required": ["languageModelPipeline"]
        }
      }
    },
    {
      "description": "A successful validation must carry at least one check. A pass with no evidence is indistinguishable from a run that did nothing.",
      "if": {
        "type": "object",
        "properties": {"successful": {"const": true}},
        "required": ["successful"]
      },
      "then": {
        "type": "object",
        "properties": {
          "checks": {"type": "array", "minItems": 1},
          "metadata": {
            "type": "object",
            "properties": {
              "languageModelPipeline": {
                "type": "object",
                "properties": {
                  "code": {"const": "VALIDATION_SUCCEEDED"},
                  "provenance": {
                    "type": "object",
                    "description": "A pass states its scope rather than naming a model. The validator never learns which model the user selected (COMPLIANCE.md C-1), so by the decision on validator #10 it validates model-independent properties only, and every tokenizer-specific limit is enforced by the finetuner against the selected model before weights load. A document claiming a model here would be claiming something the container cannot know.",
                    "properties": {
                      "modelScope": {"const": "model-agnostic"},
                      "tokenizerChecks": {"const": "finetuner"}
                    },
                    "required": ["modelScope", "tokenizerChecks"],
                    "not": {
                      "anyOf": [
                        {"required": ["baseModel"]},
                        {"required": ["baseModelRevision"]}
                      ]
                    }
                  }
                },
                "required": ["code", "provenance"]
              }
            }
          }
        }
      }
    },
    {
      "description": "A failure must not claim the success code, and every check it reports must be consistent with the outcome.",
      "if": {
        "type": "object",
        "properties": {"successful": {"const": false}},
        "required": ["successful"]
      },
      "then": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "languageModelPipeline": {
                "type": "object",
                "properties": {
                  "code": {"not": {"const": "VALIDATION_SUCCEEDED"}}
                },
                "required": ["code"]
              }
            }
          }
        }
      }
    }
  ]
}
